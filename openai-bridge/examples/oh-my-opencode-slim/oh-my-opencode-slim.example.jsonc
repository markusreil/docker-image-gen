// Example oh-my-opencode-slim configuration.
//
// This is an EXAMPLE, not active config for this repo. Config lives at
// ~/.config/opencode/oh-my-opencode-slim.json (or .jsonc).
//
// Shape:
//   - "preset" selects the active built-in preset.
//   - Built-in agents are tuned under "presets.<preset>.<agent>" and only
//     accept models / skills / mcps (no prompt).
//   - Custom agents live under top-level "agents.<name>" and MAY define
//     "prompt" and "orchestratorPrompt".
//
// Skills: an agent's "skills" list grants skills. ["*"] already includes the
// "image-generation" skill; if you list skills explicitly, add
// "image-generation" to the list.
//
// See openai-bridge/README.md#using-the-bridge-from-an-agent.
{
  "preset": "openai",
  "presets": {
    "openai": {
      "orchestrator": { "skills": ["*"] },
      "designer": { "skills": ["*", "image-generation"] }
    }
  },
  "agents": {
    "imagegen": {
      "model": "openai/gpt-5.6",
      "prompt": "Generate images locally by running openai-bridge/examples/generate-image.sh with the user's prompt, then report the saved file path. Do not attempt to edit images; no edit workflow is registered.",
      "orchestratorPrompt": "Delegate to @imagegen when the user asks to create, generate, draw, render, or illustrate an image. Do not use it for image editing.",
      "skills": [],
      "mcps": []
    }
  }
}
