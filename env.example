# vim: set ft=sh :
# local-image-ai — example configuration.
# Copy to `.env` (`cp env.example .env`) and edit. `.env` is gitignored and is
# the only file that should hold deployment-specific values or secrets.

# --- globals ---

# Base domain used to derive every service hostname (e.g. `example.com`
# produces `invokeai.example.com` and `images.example.com`).
BASE_DOMAIN=localhost

# Compose profile enabled by default: `nvidia` or `amd`.
# `docker compose up` starts the NVIDIA variant. Switch with
# `COMPOSE_PROFILES=amd docker compose up` (a shell env var overrides this
# file) or by editing this value.
COMPOSE_PROFILES=nvidia

# Docker network in which the nginx proxy talks to downstream services.
# Must match the proxy cluster's network. Downstream services declare it
# external, so the proxy cluster must be started first.
NGINX_PROXY_NETWORK=web-proxy

# UID/GID that own state written by containers with a custom entrypoint.
PUID=1000
PGID=1000

# --- invokeai ---

# Official NVIDIA/CUDA InvokeAI image (used with `--profile nvidia`).
INVOKEAI_IMAGE_CUDA=ghcr.io/invoke-ai/invokeai:latest

# Official AMD/ROCm InvokeAI image (used with `--profile amd`).
INVOKEAI_IMAGE_ROCM=ghcr.io/invoke-ai/invokeai:main-rocm

# Optional: opt in to a self-signed certificate for LAN / local testing.
# Leave false for internet-facing deployments (ACME_HOST is used there).
INVOKEAI_GEN_SELF_SIGNED_CERT=false

# --- openai-bridge ---

# Version/tag of the bridge to build and run (upstream Go module tag).
BRIDGE_VERSION=v1.6

# Bearer token required on all /v1/* bridge requests. Required.
BRIDGE_API_KEY=change-me

# HTTP Basic credentials protecting the bridge /admin UI. Required.
BRIDGE_ADMIN_USER=admin
BRIDGE_ADMIN_PASS=change-me

# Optional: Go toolchain version used in the build stage.
BRIDGE_GO_VERSION=1.26.3

# Optional: upstream request timeout (Go duration).
BRIDGE_TIMEOUT=300s

# Optional: bridge log level (debug|info|warn|error).
BRIDGE_LOG_LEVEL=info

# Optional: opt in to a self-signed certificate for LAN / local testing.
# Leave false for internet-facing deployments (ACME_HOST is used there).
BRIDGE_GEN_SELF_SIGNED_CERT=false

# Optional: SDXL model reference rendered into the bridge workflow/registry
# templates at image build time. Obtain the values from InvokeAI's model API
# (`GET /api/v2/models/`): pick the entry with `base: "sdxl"` and
# `type: "main"` and copy its `key`, `name` and `hash` from that response.
SDXL_MODEL_KEY=REPLACE_WITH_MODEL_KEY
SDXL_MODEL_NAME="your-sdxl-model"
SDXL_MODEL_HASH=REPLACE_WITH_MODEL_HASH
SDXL_MODEL_BASE=sdxl

# --- models-init ---
# models-init reuses the global PUID/PGID above; it has no extra variables.
# BUILD_DATE is build-time only, never deployment configuration: stamp it with
# `BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) docker compose build`.
